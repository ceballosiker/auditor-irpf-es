{
  "name": "auditor-irpf-es",
  "version": "1.0.0",
  "private": true,
  "description": "Auditor histórico de nóminas e IRPF en España (2012-2026) con ajuste de inflación.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceballosiker/auditor-irpf-es.git"
  },
  "homepage": "https://github.com/ceballosiker/auditor-irpf-es",
  "bugs": {
    "url": "https://github.com/ceballosiker/auditor-irpf-es/issues"
  },
  "keywords": [
    "irpf",
    "spain",
    "tax",
    "calculator",
    "payroll",
    "inflation",
    "social-security"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "build:excel": "tsx src/cli.ts",
    "charts": "tsx scripts/render-charts.ts",
    "anual:stubs": "tsx scripts/render-anual-stubs.ts && prettier --write \"docs/anual/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lighthouse": "npm run build && lhci autorun",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@types/node": "^20.14.0",
    "@vitest/browser": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.0",
    "axe-core": "^4.11.4",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.59.1",
    "prettier": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
